@model Piranha.Extend.Blocks.ImageGalleryBlock
@using Piranha.Extend.Blocks
@*
    Gallery fix (Story 5.2 walkthrough): each photo is resized through the
    ImageBlock overload, so the editor's Aspect setting applies - "Original"
    (the default) never crops; Landscape / Portrait / Widescreen / Square
    crop to that ratio. The site CSS puts every slide in a fixed 16:9 frame
    with object-fit: contain, so mixed portrait / landscape photos show whole
    and the carousel height never jumps between slides. The letterbox bars
    show a blurred copy of the same photo (a CSS background of the same URL,
    so no extra download and no extra <img> needing alt text).
*@
@{
    var unique = "gallery-" + Guid.NewGuid().ToString();
    var images = Model.Items
        .OfType<ImageBlock>()
        .Where(i => i.GetType() == typeof(ImageBlock) && i.Body.HasValue)
        .ToList();
    // Story 2.4 (block-image alt decision A): same alt rule as ImageBlock.
    var altFallback = ViewData["ImageAltFallback"] as string;
    string AltFor(Piranha.Models.Media media) =>
        new[] { media?.AltText, altFallback, media?.Title }
            .FirstOrDefault(s => !string.IsNullOrWhiteSpace(s))?.Trim() ?? "";
}

<div id="@unique" class="carousel slide gallery-block">
    <div class="carousel-indicators">
        @for (var n = 0; n < images.Count; n++)
        {
            <button type="button" data-bs-target="#@unique" data-bs-slide-to="@n" class="@(n == 0 ? "active" : "")" aria-current="true" aria-label="Slide @n"></button>
        }
    </div>
    <div class="carousel-inner">
        @foreach (var item in images)
        {
            var src = Url.Content(WebApp.Media.ResizeImage(item, 1100));
            <div class="carousel-item @(item == images.First() ? "active" : "")">
                <div class="gallery-block__frame">
                    <div class="gallery-block__backdrop" style="background-image: url('@src')" aria-hidden="true"></div>
                    <img src="@src" class="d-block w-100 gallery-block__image" alt="@AltFor(item.Body.Media)">
                </div>
            </div>
        }
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#@unique" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#@unique" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

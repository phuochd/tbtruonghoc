@model LandingPage
@*
    Story 3.1 (FR-12, AD-2/AD-5): the chrome-less paid-ads landing page
    (DESIGN.md `landing-page-cta`). HideSiteChrome drops the nav, footer and
    3-segment sticky bar; tokens, GA4 and cookie consent stay.

    Order: brand mark (plain text, no link - no escape route by design) ->
    eyebrow -> title -> hero image -> intro -> variant cards -> content
    blocks -> form section #dat-hang (quote form posting formType=landing,
    then phone/Zalo alternatives from SiteSettings) -> one fixed full-width
    CTA to #dat-hang. Every part is CMS-driven and a blank field renders
    nothing.

    Story 3.2 (FR-13): one card per visible variant (name or label set) in
    the product grid - photo, chip, title, real price (blank = "Liên hệ báo
    giá") and a per-card CTA anchor to #dat-hang. The card itself is not a
    link. landing-page.js prefills the form's product field from the CTA's
    data-lp-variant; without JS the anchor still jumps to the form.

    Story 4.2: a "Bảng cấu hình" block renders at its block position and
    feeds the #dat-hang form (no form of its own); sb-config.js loads only
    when it renders.
*@
@{
    ViewData["Title"] = !string.IsNullOrEmpty(Model.MetaTitle) ? Model.MetaTitle : Model.Title;
    ViewData["HideSiteChrome"] = true;

    var eyebrow = Model.EyebrowText;
    var intro = Model.IntroText;
    var ctaText = Model.CtaText;
    var variants = Model.VisibleVariants;
    var variantsTitle = Model.VariantsTitleText;
    var configBlock = ConfigBlock.FirstRenderable(Model.Blocks);

    var settings = await WebApp.Site.GetContentAsync<SiteSettings>();
    var telHref = ContactLinks.TelHref(settings?.Phone?.Value);
    var phoneText = string.IsNullOrWhiteSpace(settings?.Phone?.Value) ? null : settings.Phone.Value.Trim();
    var zaloHref = ContactLinks.SafeUrl(settings?.ZaloUrl?.Value);
    var showPhone = telHref != null && phoneText != null;
}
@section head {
    @await Html.PartialAsync("_MetaTags", Model)
}

<main class="sb-lp">
    <div class="container">
        <p class="sb-lp__brand">Trống Đọi Tam</p>

        @if (eyebrow != null)
        {
            <p class="sb-lp__eyebrow">@eyebrow</p>
        }
        <h1 class="sb-lp__title">@Model.Title</h1>

        @if (Model.HasHeroImage)
        {
            <img class="sb-lp__hero" src="@Url.Content(WebApp.Media.ResizeImage(Model.HeroImage, 1140))"
                 srcset="@Url.Content(WebApp.Media.ResizeImage(Model.HeroImage, 480)) 480w, @Url.Content(WebApp.Media.ResizeImage(Model.HeroImage, 768)) 768w, @Url.Content(WebApp.Media.ResizeImage(Model.HeroImage, 1140)) 1140w"
                 sizes="(min-width: 1200px) 1140px, calc(100vw - 32px)" alt="@Model.HeroAltText"
                 width="@Model.HeroImage.Media.Width" height="@Model.HeroImage.Media.Height" fetchpriority="high">
        }

        @if (intro != null)
        {
            <p class="sb-lp__intro">@intro</p>
        }

        @if (variants.Count > 0)
        {
            <section class="sb-lp__variants" aria-labelledby="@(variantsTitle != null ? "sb-lp-variants-title" : null)">
                @if (variantsTitle != null)
                {
                    <h2 class="sb-lp__variants-title" id="sb-lp-variants-title">@variantsTitle</h2>
                }
                <ul class="sb-grid sb-grid--products">
                    @foreach (var variant in variants)
                    {
                        var heading = variant.HeadingText;
                        var label = variant.LabelText;
                        var price = variant.PriceText;
                        var variantCta = variant.CtaText;
                        <li>
                            <article class="sb-card sb-lp__variant">
                                <div class="sb-card__thumb">
                                    @if (variant.HasImage)
                                    {
                                        <img src="@Url.Content(WebApp.Media.ResizeImage(variant.Image, 768))"
                                             srcset="@Url.Content(WebApp.Media.ResizeImage(variant.Image, 480)) 480w, @Url.Content(WebApp.Media.ResizeImage(variant.Image, 768)) 768w"
                                             sizes="(min-width: 1200px) 270px, (min-width: 768px) 33vw, (min-width: 480px) 50vw, calc(100vw - 32px)" alt="@variant.AltText(Model.Title)"
                                             width="@variant.Image.Media.Width" height="@variant.Image.Media.Height" loading="lazy">
                                    }
                                </div>
                                <div class="sb-card__body">
                                    @if (label != null && variant.NameText != null)
                                    {
                                        <p class="sb-lp__chip">@label</p>
                                    }
                                    @if (variantsTitle != null)
                                    {
                                        <h3 class="sb-card__title">@heading</h3>
                                    }
                                    else
                                    {
                                        <h2 class="sb-card__title">@heading</h2>
                                    }
                                    @if (price != null)
                                    {
                                        <p class="sb-card__price">@price</p>
                                    }
                                    else
                                    {
                                        <p class="sb-card__price sb-card__price--contact">@LandingVariant.ContactPriceText</p>
                                    }
                                    <a class="sb-lp__variant-cta" href="#dat-hang" data-lp-variant="@variant.PrefillText"
                                       aria-label="@(variantCta + " " + heading + " – đến form đặt hàng")">@variantCta</a>
                                </div>
                            </article>
                        </li>
                    }
                </ul>
            </section>
        }
    </div>

    @{
        // Block-image alt decision A (as on the PDP): shared ImageBlock /
        // ImageGalleryBlock templates fall back to the page title.
        ViewData["ImageAltFallback"] = Model.Title;
        // Story 4.2: a config block renders here and feeds the #dat-hang form.
        ViewData[ConfigBlock.HostViewDataKey] = true;
    }
    @foreach (var block in Model.Blocks)
    {
        if (block is ConfigBlock && block != configBlock)
        {
            continue;
        }
        <div class="block @block.CssName()">
            <div class="container">
                @Html.DisplayFor(m => block, block.GetType().Name)
            </div>
        </div>
    }
    @{
        ViewData.Remove("ImageAltFallback");
        ViewData.Remove(ConfigBlock.HostViewDataKey);
    }

    <div class="container">
        <section class="sb-lp__form" id="dat-hang" aria-labelledby="sb-lp-form-title">
            <h2 class="sb-lp__form-title" id="sb-lp-form-title">Nhận báo giá &amp; đặt hàng</h2>
            @await Html.PartialAsync("_QuoteRequestForm", new QuoteRequestFormViewModel { ProductOfInterest = Model.Title, FormType = LandingPage.FormType })

            @if (showPhone || zaloHref != null)
            {
                <p class="sb-lp__alt">
                    Hoặc liên hệ trực tiếp:
                    @if (showPhone)
                    {
                        <a class="sb-lp__alt-link" href="tel:@telHref" aria-label="Gọi @phoneText tới Đọi Tam">Gọi @phoneText</a>
                    }
                    @if (showPhone && zaloHref != null)
                    {
                        <span aria-hidden="true">·</span>
                    }
                    @if (zaloHref != null)
                    {
                        <a class="sb-lp__alt-link" href="@zaloHref" target="_blank" rel="noopener noreferrer" aria-label="Chat Zalo với Đọi Tam (mở tab mới)">Chat Zalo</a>
                    }
                </p>
            }
        </section>
    </div>
</main>

<a class="sb-lp__cta" href="#dat-hang" aria-label="@(ctaText + " – đến form đặt hàng")">@ctaText</a>

@if (configBlock != null)
{
    <script src="~/assets/js/sb-config.js" asp-append-version="true"></script>
}
<script src="~/assets/js/lead-form.js" asp-append-version="true"></script>
<script src="~/assets/js/landing-page.js" asp-append-version="true"></script>

@model ProductArchive
@*
    Story 4.1 (FR-11): DESIGN.md `drum-config-reference` - a read-only table
    (one row per option dimension, editor order) on surface-sunken, the
    "Bảng tham khảo, không tính giá tự động" disclaimer, then the shared quote
    form prefilled with "Tư vấn cấu hình – {archive title}". Never a price,
    selector or cart. Renders nothing at all when no row has both a label and
    a value. All editor text is HTML-encoded (plain @@-expressions). The page
    that embeds this includes lead-form.js when ConfigRows is non-empty.
*@
@{
    var rows = Model.ConfigRows;
}
@if (rows.Count > 0)
{
    var productOfInterest = $"Tư vấn cấu hình – {Model.Title}";
    if (productOfInterest.Length > 200)
    {
        productOfInterest = productOfInterest[..200];
    }
    <div class="container">
        <section class="sb-config" aria-labelledby="sb-config-title" data-sb-config>
            <h2 class="sb-config__title" id="sb-config-title">@Model.ConfigTitleText</h2>
            <div class="sb-config__panel">
                <table class="sb-config__table" aria-labelledby="sb-config-title">
                    <tbody>
                        @foreach (var row in rows)
                        {
                            <tr class="sb-config__row">
                                <th class="sb-config__label" scope="row">@row.Label</th>
                                <td class="sb-config__value">@row.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="sb-config__disclaimer">Bảng tham khảo, không tính giá tự động</p>
            <div class="sb-config__form">
                @await Html.PartialAsync("_QuoteRequestForm", new QuoteRequestFormViewModel { ProductOfInterest = productOfInterest })
            </div>
        </section>
    </div>
}

@inject TbTruongHoc.Web.Services.CraftsmanStory CraftsmanStory
@*
    Story 2.1: minimal Site B footer - wordmark plus this site's own address
    and phone from SiteSettings (keeps Story 1.3's per-site address render
    on Site B, which no longer includes _ContactBlock). Unset values are
    omitted; the phone goes through the shared ContactLinks rules.
    Story 2.5: plus a link to the craftsman story page, only while the site
    has a published one.
*@
@{
    var settings = await WebApp.Site.GetContentAsync<SiteSettings>();
    var phone = settings?.Phone?.Value;
    var telHref = ContactLinks.TelHref(phone);
    var address = settings?.Address?.Value;
    var story = await CraftsmanStory.GetPublishedAsync(WebApp.Site?.Id ?? Guid.Empty);
}
<footer class="sb-footer">
    <div class="sb-container">
        <p class="sb-footer__brand">Trống <span class="sb-footer__brand-accent">Đọi Tam</span></p>
        @if (!string.IsNullOrWhiteSpace(address))
        {
            <p class="sb-footer__address">@address</p>
        }
        @if (telHref != null)
        {
            <p class="sb-footer__phone"><a href="tel:@telHref">@phone</a></p>
        }
        @if (story != null)
        {
            <p class="sb-footer__story"><a href="@story.Permalink">Câu chuyện nghệ nhân</a></p>
        }
    </div>
</footer>

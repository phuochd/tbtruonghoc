@inject TbTruongHoc.Web.Services.ProductCatalog Catalog
@*
    Story 6.1: Site A top nav (DESIGN.md `nav`, `nav-dropdown`,
    `contact-chip`). Links come only from the CMS sitemap: the non-hidden
    top-level items, flat. A top-level ProductHubPage with at least one
    category tile (ProductCatalog.GetHubTilesAsync - the same hide rule as
    Site B's hub grid) becomes the "Sản phẩm" dropdown trigger: its tiles,
    a divider, then "Xem tất cả {N} nhóm sản phẩm →" to the hub. No tiles
    -> a plain link. Nothing hardcoded; no cart/login/account UI.

    >= 1024px: inline links; the dropdown opens on hover and on click /
    Enter / Space / ArrowDown of its trigger button (site-a.js). < 1024px:
    wordmark + chip (icon-only) + hamburger; the menu is a right-side teal
    sheet with a close button and "Sản phẩm" expands inline as an
    accordion (same panel markup). The hamburger sits before the menu in
    DOM order so the opened sheet is next in the tab order; the chip comes
    last, inside the nav bar, so it is always visible.

    Without JS (html:not(.js)): >= 1024px the panel shows on :hover /
    :focus-within of its item; < 1024px the whole list, panel included,
    shows in normal flow under the bar.
*@
@{
    var settings = await WebApp.Site.GetContentAsync<SiteSettings>();
    var phone = settings?.Phone?.Value?.Trim();
    var telHref = ContactLinks.TelHref(phone);
    var zaloHref = ContactLinks.SafeUrl(settings?.ZaloUrl?.Value);
    var hasChip = telHref != null || zaloHref != null;

    var siteId = WebApp.Site?.Id ?? Guid.Empty;
    var items = (await WebApp.Site.Sitemap.ForUserAsync(User, Auth)).Where(i => !i.IsHidden).ToList();

    // Tiles per top-level ProductHubPage (by id); absent = plain link.
    var dropdowns = new Dictionary<Guid, IReadOnlyList<CategoryTileModel>>();
    foreach (var item in items)
    {
        if (ProductHubPage.IsHub(item))
        {
            var tiles = await Catalog.GetHubTilesAsync(siteId, item.Id);
            if (tiles.Count > 0)
            {
                dropdowns[item.Id] = tiles;
            }
        }
    }
}
<header class="sa-nav" data-sa-nav data-menu-open="false">
    <div class="sa-nav__bar sa-container">
        <a class="sa-nav__brand" href="~/">NGỌC ANH</a>

        @if (items.Count > 0)
        {
            <button type="button" class="sa-nav__toggle" aria-expanded="false" aria-controls="sa-nav-menu" data-sa-nav-toggle>
                <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                <span class="visually-hidden">Menu</span>
            </button>

            <nav class="sa-nav__menu" id="sa-nav-menu" aria-label="Điều hướng chính" data-sa-nav-menu>
                <div class="sa-nav__sheet-head">
                    <button type="button" class="sa-nav__close" data-sa-nav-close>
                        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                        <span class="visually-hidden">Đóng menu</span>
                    </button>
                </div>
                <ul class="sa-nav__list">
                    @foreach (var item in items)
                    {
                        var isCurrent = item.Id == WebApp.PageId;
                        var isActive = isCurrent || item.HasChild(WebApp.PageId);
                        var itemUrl = WebApp.Url(item);
                        if (dropdowns.TryGetValue(item.Id, out var tiles))
                        {
                            var panelId = "sa-dd-" + item.Id.ToString("N");
                            <li class="sa-nav__item has-dropdown@(isActive ? " is-active" : "")" data-sa-dropdown>
                                <button type="button" class="sa-nav__link sa-nav__trigger" aria-expanded="false" aria-controls="@panelId" data-sa-dropdown-toggle>
                                    @item.MenuTitle
                                    <svg class="sa-nav__chevron" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </button>
                                <div class="sa-dropdown" id="@panelId" data-sa-dropdown-panel>
                                    <ul class="sa-dropdown__list">
                                        @foreach (var tile in tiles)
                                        {
                                            <li><a class="sa-dropdown__link" href="@tile.Permalink" data-sa-dropdown-item>@tile.Title</a></li>
                                        }
                                    </ul>
                                    <hr class="sa-dropdown__divider">
                                    <a class="sa-dropdown__all" href="@itemUrl" aria-current="@(isCurrent ? "page" : null)" data-sa-dropdown-item>Xem tất cả @tiles.Count nhóm sản phẩm →</a>
                                </div>
                            </li>
                        }
                        else
                        {
                            <li class="sa-nav__item@(isActive ? " is-active" : "")">
                                <a class="sa-nav__link" href="@itemUrl" aria-current="@(isCurrent ? "page" : null)">@item.MenuTitle</a>
                            </li>
                        }
                    }
                </ul>
            </nav>
        }

        @if (hasChip)
        {
            <div class="sa-chip">
                @if (telHref != null)
                {
                    <a class="sa-chip__link sa-chip__link--call" href="tel:@telHref" aria-label="Gọi ngay tới Ngọc Anh – @phone">
                        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" fill="currentColor"/></svg>
                        <span class="sa-chip__text">@phone</span>
                    </a>
                }
                @if (zaloHref != null)
                {
                    <a class="sa-chip__link sa-chip__link--zalo" href="@zaloHref" target="_blank" rel="noopener noreferrer" aria-label="Chat Zalo với Ngọc Anh">
                        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3C6.5 3 2 6.8 2 11.5c0 2.6 1.4 4.9 3.6 6.5L5 21l3.6-1.9c1.1.3 2.2.4 3.4.4 5.5 0 10-3.8 10-8.5S17.5 3 12 3z" fill="currentColor"/></svg>
                        <span class="sa-chip__text">Zalo</span>
                    </a>
                }
            </div>
        }
    </div>
</header>

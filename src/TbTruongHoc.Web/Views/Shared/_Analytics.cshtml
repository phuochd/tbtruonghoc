@using TbTruongHoc.Web.Models
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@*
    Story 1.6 (FR-4): renders this site's own Search Console verification
    meta tag and GA4 hook - never hardcoded, never another site's values.
    Included in _Layout.cshtml's <head> so both apply to every page on both
    sites without touching per-type views, mirroring _ContactBlock.cshtml's
    read pattern.

    Both pieces render only when their own field is set, and values are
    format-validated (SiteSettingsValidation), same defense-in-depth
    convention as Story 1.3's Zalo/Maps URLs: an invalid value is treated as
    unset here, and rejected outright at save time by Program.cs's
    OnBeforeSave hook.

    Story 1.10: GA4 is additionally gated by AnalyticsGate (Production only)
    and by visitor consent. This partial never emits gtag.js itself - only
    analytics-consent.js, which injects gtag.js after the visitor accepts
    (see _CookieConsent.cshtml for the banner). The measurement ID reaches
    the script through an HTML-encoded data- attribute, never inline script.
    The verification meta tag is not tracking and stays ungated.
*@
@{
    var settings = await WebApp.Site.GetContentAsync<SiteSettings>();
    var ga4Id = settings?.Ga4MeasurementId?.Value;
    var verification = settings?.SearchConsoleVerification?.Value;

    var loadGa4 = AnalyticsGate.ShouldLoadGa4(Env, ga4Id);
    var hasVerification = SiteSettingsValidation.IsValidSearchConsoleVerification(verification);
}
@if (hasVerification)
{
    <meta name="google-site-verification" content="@verification">
}
@if (loadGa4)
{
    <script src="~/assets/js/analytics-consent.js" data-ga4-id="@ga4Id" defer asp-append-version="true"></script>
}

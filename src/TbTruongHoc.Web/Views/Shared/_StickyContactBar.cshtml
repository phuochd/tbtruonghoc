@*
    Story 2.1: Site B sticky contact bar (DESIGN.md `sticky-contact-bar`).
    Fixed to the viewport bottom at every breakpoint and never auto-hides.
    Values come from the current site's SiteSettings through ContactLinks -
    the same sanitizing rules as _ContactBlock. An unset/unsafe value drops
    its segment; with no segment left the bar is not rendered at all (the
    layout then also drops the body bottom-padding class).

    Rendered after <main> and the footer so it never traps focus ahead of
    the page content. Zalo URL is used as-is (https://zalo.me/<n> already
    falls back to web).
*@
@{
    var settings = await WebApp.Site.GetContentAsync<SiteSettings>();
    var telHref = ContactLinks.TelHref(settings?.Phone?.Value);
    var zaloHref = ContactLinks.SafeUrl(settings?.ZaloUrl?.Value);
    var mapsHref = ContactLinks.SafeUrl(settings?.MapsUrl?.Value);
}
@if (telHref != null || zaloHref != null || mapsHref != null)
{
    <nav class="sb-contact-bar" aria-label="Liên hệ nhanh">
        <ul class="sb-contact-bar__list">
            @if (telHref != null)
            {
                <li class="sb-contact-bar__item">
                    <a class="sb-contact-bar__seg sb-contact-bar__seg--call" href="tel:@telHref" aria-label="Gọi ngay tới Đọi Tam">
                        <svg class="sb-icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span>Gọi ngay</span>
                    </a>
                </li>
            }
            @if (zaloHref != null)
            {
                <li class="sb-contact-bar__item">
                    <a class="sb-contact-bar__seg sb-contact-bar__seg--zalo" href="@zaloHref" target="_blank" rel="noopener noreferrer" aria-label="Chat Zalo với Đọi Tam (mở tab mới)">
                        <svg class="sb-icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.8-.8L3 21l1.9-5.2A8.4 8.4 0 0 1 3 11.5 8.5 8.5 0 0 1 12 3a8.5 8.5 0 0 1 9 8.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span>Chat Zalo</span>
                    </a>
                </li>
            }
            @if (mapsHref != null)
            {
                <li class="sb-contact-bar__item">
                    <a class="sb-contact-bar__seg sb-contact-bar__seg--maps" href="@mapsHref" target="_blank" rel="noopener noreferrer" aria-label="Bản đồ đường tới Đọi Tam (mở tab mới)">
                        <svg class="sb-icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 22s7-6.1 7-12a7 7 0 0 0-14 0c0 5.9 7 12 7 12z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.5" fill="none" stroke="currentColor" stroke-width="2"/></svg>
                        <span>Bản đồ</span>
                    </a>
                </li>
            }
        </ul>
    </nav>
}

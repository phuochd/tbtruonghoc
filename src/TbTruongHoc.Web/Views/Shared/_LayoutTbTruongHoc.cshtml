@*
    Story 6.1: Site A (tbtruonghoc.com) page shell - the "Xanh Lục Bảo Rạng
    Rỡ" system. Picked by _ViewStart.cshtml via SiteLayout; _Layout.cshtml
    stays the no-site fallback. Loads only Mulish (never the sample theme's
    style.min.css, Lato/Raleway or Site B's Be Vietnam Pro). Bootstrap CSS
    stays because shared partials use its utilities; site-a.css re-points its
    font/color variables at the Site A tokens.

    DOM order is the keyboard order: skip link -> nav (incl. contact chip)
    -> main content -> footer. ViewData["HideSiteChrome"] = true drops nav,
    chip and footer while tokens, analytics and cookie consent stay.
*@
@{
    var hideChrome = ViewData["HideSiteChrome"] is true;
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>@ViewData["Title"]</title>
    <script>document.documentElement.classList.add('js');</script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    @* css2 serves the Vietnamese unicode-range subset automatically; browsers only fetch the ranges a page uses. *@
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mulish:wght@400;600;700;800&display=swap">
    <link rel="stylesheet" href="~/assets/css/site-a.css" asp-append-version="true">

    @await Html.PartialAsync("_Analytics")

    @RenderSection("head", required: false)
</head>

<body class="site-a@(hideChrome ? "" : " sa-has-nav")">
    <a class="sa-skip-link" href="#main-content">Bỏ qua đến nội dung chính</a>

    @if (!hideChrome)
    {
        @await Html.PartialAsync("_SiteANav")
    }

    <div id="main-content" class="sa-main" tabindex="-1">
        @RenderBody()
    </div>

    @if (!hideChrome)
    {
        @await Html.PartialAsync("_SiteAFooter")
    }

    @await Html.PartialAsync("_CookieConsent")

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/assets/js/site-a.js" asp-append-version="true"></script>
</body>
</html>

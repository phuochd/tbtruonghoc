@*
    Story 2.1: Site B (trongdoitam.net) page shell - the "Mộc Trầm" system.
    Picked by _ViewStart.cshtml via SiteLayout; Site A keeps _Layout.cshtml
    untouched. Loads only Be Vietnam Pro (never the sample theme's
    style.min.css or Lato/Raleway). Bootstrap CSS stays because existing
    partials use its utilities; site-b.css re-points its font/color
    variables at the Mộc Trầm tokens.

    DOM order is the keyboard order: skip link -> nav -> main content ->
    footer -> sticky contact bar. ViewData["HideSiteChrome"] = true (set by
    Epic 3's landing-page template) drops nav, footer and sticky bar while
    tokens, analytics and cookie consent stay.
*@
@{
    var hideChrome = ViewData["HideSiteChrome"] is true;

    var settings = hideChrome ? null : await WebApp.Site.GetContentAsync<SiteSettings>();
    var hasContactBar = settings != null
        && (ContactLinks.TelHref(settings.Phone?.Value) != null
            || ContactLinks.SafeUrl(settings.ZaloUrl?.Value) != null
            || ContactLinks.SafeUrl(settings.MapsUrl?.Value) != null);

    var bodyClasses = "site-b";
    if (!hideChrome)
    {
        bodyClasses += " sb-has-nav";
    }
    if (hasContactBar)
    {
        bodyClasses += " sb-has-bar";
    }
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>@ViewData["Title"]</title>
    <script>document.documentElement.classList.add('js');</script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    @* css2 serves the Vietnamese unicode-range subset automatically; browsers only fetch the ranges a page uses. *@
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;700&display=swap">
    <link rel="stylesheet" href="~/assets/css/site-b.css" asp-append-version="true">

    @await Html.PartialAsync("_Analytics")

    @RenderSection("head", required: false)
</head>

<body class="@bodyClasses">
    <a class="sb-skip-link" href="#main-content">Bỏ qua đến nội dung chính</a>

    @if (!hideChrome)
    {
        @await Html.PartialAsync("_SiteBNav")
    }

    <div id="main-content" class="sb-main" tabindex="-1">
        @RenderBody()
    </div>

    @if (!hideChrome)
    {
        @await Html.PartialAsync("_SiteBFooter")
        @await Html.PartialAsync("_StickyContactBar")
    }

    @await Html.PartialAsync("_CookieConsent")

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    @if (!hideChrome)
    {
        <script src="~/assets/js/site-b-nav.js" asp-append-version="true"></script>
    }
</body>
</html>
